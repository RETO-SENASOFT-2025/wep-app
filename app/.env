# Longitud máxima del mensaje en el frontend
MESSAGE_MAX_LENGTH=500

# URL del backend de IA (endpoint HTTP POST)
# Debe recibir JSON: {"message": "texto", "conversation_id": <id opcional>}
# Debe responder JSON: {"reply": "texto de respuesta"}
# Ejemplo: http://localhost:9000/ai/message
AI_API_URL="http://localhost:8011"
